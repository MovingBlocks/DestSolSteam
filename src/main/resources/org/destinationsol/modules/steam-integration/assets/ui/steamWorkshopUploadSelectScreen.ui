{
    "type": "SteamWorkshopUploadSelectScreen",
    "skin": "engine:mainMenu",
    "contents": {
        "type": "RelativeLayout",
        "contents": [
            {
                "type": "UIBackingBox",
                "content": {
                    "type": "RelativeLayout",
                    "contents": [
                        {
                            "type": "ScrollableArea",
                            "content": {
                                "type": "UIList",
                                "id": "modulesList",
                                "family": "menuButtons"
                            },
                            "layoutInfo": {
                                "position-top": {
                                    "offset": 32
                                },
                                "position-bottom": {
                                    "widget": "actionButtonsLayout",
                                    "target": "TOP",
                                    "offset": 16
                                }
                            }
                        },
                        {
                            "type": "ColumnLayout",
                            "id": "actionButtonsLayout",
                            "columns": "2",
                            "column-widths": [0.5, 0.5],
                            "horizontalSpacing": 8,
                            "contents": [
                                {
                                    "type": "UIButton",
                                    "id": "cancelButton",
                                    "text": "Cancel"
                                },
                                {
                                    "type": "UIButton",
                                    "id": "uploadButton",
                                    "text": "Upload"
                                }
                            ],
                            "layoutInfo": {
                                "position-horizontal-center": {},
                                "position-bottom": {
                                    "offset": 32
                                },
                                "position-left": {
                                    "offset": 32
                                },
                                "position-right": {
                                    "offset": 32
                                },
                                "use-content-height": true
                            }
                        }
                    ]
                },
                "layoutInfo": {
                    "position-horizontal-center": {},
                    "position-vertical-center": {},
                    "position-top": {
                        "offset": 64
                    },
                    "position-bottom": {
                        "offset": 64
                    },
                    "position-left": {
                        "offset": 64
                    },
                    "position-right": {
                        "offset": 64
                    }
                }
            }
        ]
    }
}